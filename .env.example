# Copy this file to .env before running Docker Compose.
POSTGRES_DB=careerverse
POSTGRES_USER=careerverse
POSTGRES_PASSWORD=replace-with-a-strong-password

DJANGO_SECRET_KEY=replace-with-an-independently-generated-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
WEB_APP_ORIGIN=http://localhost:8080

FRONTEND_PORT=8080
BACKEND_PORT=8000

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GOOGLE_CLIENT_ID=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
